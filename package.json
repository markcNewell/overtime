{
  "name": "overtime",
  "productName": "Overtime",
  "version": "0.1.0-alpha.4",
  "description": "A tiny desktop office worker, powered by your Claude subscription, that you have to manage.",
  "author": "Mark Newell",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "electron --ozone-platform=headless --no-sandbox scripts/make-icons.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win-portable": "npm run build && electron-builder --win portable --x64 --publish never -c.win.signAndEditExecutable=false",
    "preview:office": "npm run build && electron --ozone-platform=headless --no-sandbox scripts/preview-office.cjs",
    "e2e": "npm run build && node scripts/e2e-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.marknewell.overtime",
    "productName": "Overtime",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "markcNewell",
        "repo": "overtime"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5"
  }
}
